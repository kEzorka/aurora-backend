# Everything here is reproducible from the code plus the archive, and all of it
# is large enough to make a clone useless if committed.
.venv/
.venv312/
__pycache__/
*.pyc

# Forecast stores. One 40-step run is 7 GB.
outputs/
outputs_*/
bench/scratch/

# Benchmark output is kept: the charts are drawn from it, and a chart whose
# input is not in the repo cannot be checked.
!bench/results/
!bench/charts/

.DS_Store
report/build/

# Артефакты прогонов: forecast.zarr + manifest.json + validation.json.
# Манифесты маленькие, но без своего Zarr бессмысленны, поэтому каталог целиком.
artifacts/*
!artifacts/.gitkeep

# Ключи. Ни один не должен попасть ни в репозиторий, ни в manifest.json
# (docs/SETUP.md §1).
.env
.cdsapirc

.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
