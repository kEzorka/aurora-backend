# Measured, not guessed: a session that sends nothing is killed after 600 s of
# silence (bench/results/ssh.json in ~/aurora-backend). ServerAliveInterval
# makes the client speak every 15 s, which kept a 900 s silent session alive.
Host aurora-box
    HostName AURORA_HOST
    User AURORA_USER
    ServerAliveInterval 15
    ServerAliveCountMax 6
    TCPKeepAlive yes
    # One TCP connection reused by every later ssh/scp to the box: fewer
    # password logins, and no new handshake per command.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m
