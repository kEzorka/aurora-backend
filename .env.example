# Скопировать в .env. Файл .env в .gitignore и туда не возвращается.
# Никаких токенов в коде, в конфигах репозитория и в manifest.json
# (docs/SETUP.md §1).

# Веса Aurora на Hugging Face, репозиторий microsoft/aurora.
HF_TOKEN=

# Корень данных проекта. Внутри: forecast/, analysis/, history/, cache/,
# scratch/, meta/. Квота — в storage/budget.py.
AURORA_ROOT=~/aurora-data

AURORA_LOG_LEVEL=info

# CDS (ERA5 и ряды в точке) читает ~/.cdsapirc, а не эти переменные.
# Лицензию ERA5 нельзя принять из API — открыть страницу датасета руками
# и нажать Accept, иначе запрос падает с
#   403 required licences not accepted
#
# ECMWF Open Data и GFS на AWS ключей не требуют вовсе.
